# MongoDB Atlas connection string. Include a database name (e.g. /jobportal) before the "?".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/jobportal?retryWrites=true&w=majority

# Port the backend server listens on
PORT=5000

# The deployed frontend URL (used to restrict CORS in production).
# For local dev, keep this as the Vite dev server URL.
FRONTEND_URL=http://localhost:5173
